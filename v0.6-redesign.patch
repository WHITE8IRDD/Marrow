+.toast { padding: 12px 16px; border-radius: 14px; background: color-mix(in srgb, var(--panel) 80%, transparent); backdrop-filter: blur(16px) saturate(1.3); border: 1px solid var(--line-2); border-left: 3px solid var(--accent); box-shadow: var(--shadow); animation: toastIn .25s var(--ease); }
 .toast.bad { border-left-color: var(--bad); }
 .toast.ok { border-left-color: var(--ok); }
 .toast a { text-decoration: underline; }
